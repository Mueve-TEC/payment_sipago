<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Sipago Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group attrs="{'invisible': [('code', '!=', 'sipago')]}">
                    <field name="sipago_client_id"
                           string="Client ID"
                           attrs="{'required': [('code', '=', 'sipago'), ('state', '!=', 'disabled')]}"
                           password="True"/>
                    <field name="sipago_client_secret"
                            string="Client Secret"
                            attrs="{'required': [('code', '=', 'sipago'), ('state', '!=', 'disabled')]}"
                            password="True"/>
                </group>
            </group>
            <page name="configuration" position="inside">
                <group string="Sipago Configuration" attrs="{'invisible': [('code', '!=', 'sipago')]}">
                    <field name="sipago_env"
                           string="Operation Mode"
                           required="1"
                           attrs="{'required': [('code', '=', 'sipago'), ('state', '!=', 'disabled')]}"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
            </page>
        </field>
    </record>

</odoo>
