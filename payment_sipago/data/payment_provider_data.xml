<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Sipago is not a core provider, so the generic record does not exist in `payment`.
        The record is namespaced under `payment` (core convention for provider records) and
        `forcecreate` is required by Odoo 19 to create a foreign-module record.
    -->
    <record id="payment.payment_provider_sipago" model="payment.provider" forcecreate="True">
        <field name="name">Sipago</field>
        <field name="code">sipago</field>
        <field name="image_128" type="base64" file="payment_sipago/static/description/sipago_icon.png" />
        <field name="module_id" ref="base.module_payment_sipago" />
        <!-- Sipago processes debit and credit card payments -->
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_visa'),
                         ref('payment.payment_method_mastercard'),
                     ])]" />
        <field name="redirect_form_view_id" ref="redirect_form" />
    </record>
</odoo>
